# Configure these values in Render > Web Service > Environment.
SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:postgresql://aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.project-ref
DB_PASSWORD=replace-with-supabase-database-password
JWT_SECRET=replace-with-a-long-random-secret
APP_CORS_ORIGINS=https://your-frontend.example.com

# Optional: required only for the transcription token feature.
DEEPGRAM_API_KEY=
DEEPGRAM_PROJECT_ID=
